# Telegram Bot API Token obtained from @BotFather on Telegram
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=iris_bot
DB_USER=postgres
DB_PASSWORD=YOUR_DB_PASSWORD

# Telegram Private Repository Channel ID (e.g. -1001234567890)
REPOSITORY_CHANNEL_ID=YOUR_REPOSITORY_CHANNEL_ID
